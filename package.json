{
  "name": "farsight",
  "productName": "FarSight",
  "version": "0.1.0",
  "description": "Cross-platform screen-break and eye-health reminder app for macOS and Windows.",
  "main": "dist/main/main.js",
  "author": "FarSight",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build-native.mjs && node scripts/build.mjs",
    "start": "npm run build && node scripts/electron.mjs",
    "dev": "npm run build && node scripts/electron.mjs --dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "npm run build && node scripts/electron.mjs --screenshots",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "build:native": "node scripts/build-native.mjs",
    "dist:win-zip": "npm run build && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "app.farsight.desktop",
    "productName": "FarSight",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "build/bin/farsight-mic",
          "to": "bin/farsight-mic"
        }
      ]
    },
    "dmg": {
      "artifactName": "FarSight-${version}-${arch}.dmg"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "FarSight-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FarSight-Setup-${version}.exe"
    }
  }
}
